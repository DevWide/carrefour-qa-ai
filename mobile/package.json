{
  "name": "carrefour-qa-ai-mobile",
  "version": "1.0.0",
  "description": "Automação mobile do native-demo-app (WebdriverIO + Appium + Mocha + Chai + Allure)",
  "scripts": {
    "apps:download": "node scripts/download-apps.js",
    "drivers:install": "appium driver install uiautomator2 || true; appium driver install xcuitest || true",
    "test:android": "wdio run config/wdio.android.conf.js",
    "test:ios": "wdio run config/wdio.ios.conf.js",
    "test:browserstack": "wdio run config/wdio.browserstack.conf.js",
    "test:smoke:ios": "MOCHA_GREP=@smoke wdio run config/wdio.ios.conf.js",
    "report:generate": "allure generate allure-results -o allure-report",
    "report:open": "allure open allure-report",
    "clean": "rm -rf allure-results allure-report evidence logs"
  },
  "devDependencies": {
    "@wdio/allure-reporter": "^9.32.0",
    "@wdio/appium-service": "^9.32.0",
    "@wdio/browserstack-service": "^9.39.2",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "allure": "^3.19.1",
    "appium": "^3.8.0",
    "chai": "^4.5.0",
    "dotenv": "^18.0.5"
  },
  "type": "module",
  "private": true
}
