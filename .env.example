# Copie para .env (não versionado) e preencha o que for usar.

# Camada de IA (opcional — sem chave, tudo funciona em modo heurístico)
# Use UMA das chaves; o fornecedor é detectado automaticamente (ou force com AI_PROVIDER=openai|gemini|anthropic)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
AI_PROVIDER=
AI_MODEL=   # padrão: gpt-4o-mini (OpenAI), gemini-2.5-flash (Gemini) ou claude-sonnet-5-5 (Claude)

# TypeSafe AI (Jev) — triagem rápida de falhas antes do LLM (economiza tokens)
# Obtenha em: https://typesafe.ai (API Keys)
JEV_API_KEY=
JEV_MODEL=jev-latest   # ou fixe uma versão: jev-1.13.0
JEV_CONFIDENCE_THRESHOLD=0.85   # confiança mínima para aceitar triagem do Jev sem LLM (0.0-1.0)
JEV_DISABLED=false   # true para desativar o Jev mesmo com chave configurada

# API
API_BASE_URL=http://localhost:3000
API_SLA_MS=1000

# Mobile — opcional: sobrescreve o dispositivo detectado automaticamente
IOS_DEVICE_NAME=
IOS_PLATFORM_VERSION=
ANDROID_DEVICE_NAME=
SCREENSHOTS=all   # all | failures

# BrowserStack (dispositivos reais)
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
BS_ANDROID_DEVICES=Samsung Galaxy S23:13.0,Google Pixel 8:14.0
