{
  "name": "carrefour-qa-ai-api",
  "version": "1.0.0",
  "description": "Suíte de testes automatizados da API de usuários (ServeRest) com camada de IA",
  "type": "module",
  "private": true,
  "scripts": {
    "api:start": "serverest --timeout 3600",
    "test": "mocha --grep @known-issue --invert",
    "test:all": "mocha",
    "test:known-issues": "mocha --grep @known-issue",
    "test:smoke": "mocha --grep @smoke",
    "report:generate": "allure generate allure-results -o allure-report",
    "report:open": "allure open allure-report",
    "clean": "rm -rf allure-results allure-report"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "allure": "^3.19.1",
    "allure-js-commons": "^3.13.0",
    "allure-mocha": "^3.13.0",
    "axios": "^1.20.0",
    "chai": "^4.5.0",
    "mocha": "^12.0.2",
    "serverest": "^3.2.2"
  }
}
